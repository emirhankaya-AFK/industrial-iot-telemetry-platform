# ==============================================================================
# Industrial Edge IoT Telemetry Gateway - Environment Configuration Template
# ==============================================================================
# Copy this template to .env before starting containers:
#   cp .env.example .env
#
# DO NOT commit the .env file containing production secrets to version control.
# ==============================================================================

# Runtime Environment (production / development)
IOT_ENV=production

# Security & Authentication
# Enforce HMAC-SHA256 device authentication on ingestion endpoints
IOT_ENFORCE_AUTH=true

# Master SCADA / Edge HMAC Authentication Secret Key
# Generate a cryptographically secure key (e.g., openssl rand -hex 32)
IOT_AUTH_SECRET=replace_with_a_secure_random_hex_string_32_bytes_minimum

# Streaming Message Broker & Queue
REDIS_URL=redis://redis:6379/0

# MQTT Telemetry Ingestion Broker
MQTT_HOST=mqtt
MQTT_PORT=1883

# Optional: Device-Specific Secret Overrides (JSON string)
# If devices use independent pre-shared keys rather than the gateway master secret:
# IOT_DEVICE_SECRETS={"motor-alpha-01":"secret_key_1","conveyor-beta-02":"secret_key_2"}
